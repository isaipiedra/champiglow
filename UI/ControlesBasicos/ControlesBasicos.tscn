bbcode_enabled = true
text = "
[font_size=25][b]Girar Cámara[/b]: o	Manten presionado el clic derecho del ratón y desplaza el cursor a lo largo de la pantalla

[b]Desplazarse por el escenario[/b]: Para todos los movimientos de desplazamiento por el entorno se debe de mantener presionado el clic derecho del ratón y luego presionar la tecla deseada. Las teclas que presionar son las siguientes:

[ul]
[b]W:[/b] Hacia adelante
[b]S:[/b] Hacia atrás
[b]D:[/b] Hacia la derecha
[b]A:[/b] Hacia la izquierda
[b]Q:[/b] Hacia la abajo
[b]E:[/b] Hacia arriba
[/ul][/font_size]
"
fit_content = true
scroll_active = false

